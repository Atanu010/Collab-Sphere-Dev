# =============================================================================
# CollabSphere Production Environment Variables
# =============================================================================

# MongoDB Connection String (e.g., MongoDB Atlas Free Tier M0)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database Name
DB_NAME=collabsphere

# JWT Secret Key for token signing
JWT_SECRET=replace_with_a_secure_random_secret_string

# Optional: Default admin credentials seeded on first startup
ADMIN_EMAIL=admin@collabsphere.com
ADMIN_PASSWORD=admin123

# Optional: Frontend origin if frontend is hosted separately (for CORS)
# FRONTEND_URL=http://localhost:3000

# Server listening port (default: 8000, Render sets 10000)
PORT=8000
